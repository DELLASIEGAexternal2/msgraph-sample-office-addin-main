<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>5f7c22ff-4d32-4851-a19a-06505f310952</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>MSGraph Action</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="DSPS CO/IE Graph Fonctions SSO_Auth_Permissions"/>
  <Description DefaultValue="Un module complémentaire qui explique comment utiliser Microsoft Graph pour accéder au calendrier de l'utilisateur.
"/>
  <IconUrl DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/src/addin/consent.html"/>
  <AppDomains>
    <AppDomain>https://dellasiegaexternal2.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/taskpane/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ImportCalendar</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://docs.microsoft.com/graph"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://dellasiegaexternal2.github.io/msgraph-sample-office-addin-main/graph-tutorial/taskpane/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Commencez dès maintenant avec le module complémentaire Calendrier graphique Excel !
!"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Graph Calendar"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Importer le Calendar"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Module complémentaire installé avec succès. Accédez à l'onglet ACCUEIL et cliquez sur le bouton « Importer le calendrier » pour commencer"/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Click pour ouvrir le Calendar "/>
      </bt:LongStrings>
    </Resources>
    <WebApplicationInfo>
      <Id>28760216-8eae-4635-a706-6353bc5e1004</Id>
      <Resource>api://e92a8324-40d8-4ce5-876d-99df6b07acf9</Resource>
      <Scopes>
        <Scope>openid</Scope>
        <Scope>profile</Scope>
        <Scope>access_as_user</Scope>
      </Scopes>
    </WebApplicationInfo>
  </VersionOverrides>
</OfficeApp>
